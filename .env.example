# Voho — the speaking half. Create a token at https://app.voho.ai (API Tokens).
VOHO_API_KEY=voho_sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
VOHO_BASE_URL=https://app.voho.ai
# Najdi voices: omar is bright and quick, which suits a busy counter.
VOHO_VOICE=omar
VOHO_MODEL=sada-1

# Speech-to-text, only for the self-assembled route. A Voho voice agent does
# the listening for you; this is here because this example drives the
# conversation itself and uses Voho for the voice.
#   twilio  the transcript arrives in the webhook (no extra key needed)
#   openai  Whisper, needs OPENAI_API_KEY
#   custom  your own endpoint at STT_URL
STT_PROVIDER=twilio
STT_LANGUAGE=ar-SA
# OPENAI_API_KEY=
# STT_URL=

# Telephony. Only needed for real calls — examples/cli.py and ui.py run without.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_URL=

# Where a finished ticket is sent. Left empty, tickets are logged and kept
# in memory on /api/orders.
POS_URL=
